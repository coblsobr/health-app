{
  "expo": {
    "name": "Health",
    "slug": "health-app",
    "owner": "coblsobr",
    "scheme": "healthapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.codys.healthapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF5C39"
      },
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codys.healthapp"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "84848a62-4d68-4358-b90a-fa57895b0e2f"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/84848a62-4d68-4358-b90a-fa57895b0e2f"
    }
  }
}
