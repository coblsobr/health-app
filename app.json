{
  "expo": {
    "name": "Health",
    "slug": "health-app",
    "owner": "coblsobr",
    "scheme": "healthapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.codys.healthapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FF5C39"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codys.healthapp"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-updates",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Used only when you pick a photo for a recipe.",
          "cameraPermission": "Used to photograph a cookbook page so the recipe can be read."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to photograph recipe pages. Pages are read on your phone and never uploaded."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "84848a62-4d68-4358-b90a-fa57895b0e2f"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/84848a62-4d68-4358-b90a-fa57895b0e2f"
    }
  }
}